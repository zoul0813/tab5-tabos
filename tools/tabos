#!/usr/bin/env python3

from __future__ import annotations

import argparse
import subprocess

from tabos_tools.build import (
    CONFIGURATIONS,
    command_build,
    command_flash,
    command_run,
    command_test,
)
from tabos_tools.common import ESP_IDF_VERSION, fail, identity_value
from tabos_tools.config import command_config
from tabos_tools.environment import command_activate_idf, command_setup


def command_target(args: argparse.Namespace) -> None:
    handlers = {
        "build": command_build,
        "test": command_test,
        "run": command_run,
        "flash": command_flash,
    }
    handlers[args.action](args)


def normalize_target_arguments(args: argparse.Namespace) -> None:
    values = args.target_arguments
    if len(values) == 1:
        args.configuration = "debug"
        args.action = values[0]
    elif len(values) == 2:
        args.configuration, args.action = values
    else:
        fail("target command expects [debug|release] <action>")

    if args.configuration not in CONFIGURATIONS:
        fail("configuration must be debug or release")
    actions = {"build", "flash"} if args.target == "tab5" else {"build", "test", "run"}
    if args.action not in actions:
        fail(f"target '{args.target}' action must be one of: {', '.join(sorted(actions))}")


def parse_args() -> argparse.Namespace:
    system_name = identity_value("TABOS_SYSTEM_NAME")
    parser = argparse.ArgumentParser(
        description=f"Build, test, run, flash, and set up {system_name} targets"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    for target in ("macos", "linux", "tab5"):
        target_parser = subparsers.add_parser(target, help=f"operate on {target} target")
        actions = ("build", "flash") if target == "tab5" else ("build", "test", "run")
        target_parser.add_argument(
            "target_arguments",
            nargs="+",
            metavar="[debug|release] action",
            help=f"optional configuration followed by one of: {', '.join(actions)}",
        )
        target_parser.set_defaults(
            target=target,
            handler=command_target,
            argument_normalizer=normalize_target_arguments,
        )

    setup_parser = subparsers.add_parser(
        "setup", help=f"install host tools and ESP-IDF {ESP_IDF_VERSION}"
    )
    setup_parser.set_defaults(handler=command_setup)

    activate_idf_parser = subparsers.add_parser(
        "activate-idf", help="print shell commands that activate project-local ESP-IDF"
    )
    activate_idf_parser.set_defaults(handler=command_activate_idf)

    config_parser = subparsers.add_parser(
        "config", help="configure shared TabOS host and device options"
    )
    config_parser.set_defaults(handler=command_config)

    args = parser.parse_args()
    normalizer = getattr(args, "argument_normalizer", None)
    if normalizer is not None:
        normalizer(args)
    return args


def main() -> int:
    args = parse_args()
    try:
        args.handler(args)
    except subprocess.CalledProcessError as error:
        return error.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
